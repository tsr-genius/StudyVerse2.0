
export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ error: "Use POST." });
  }

  const key = process.env.OPENAI_API_KEY;
  const model = process.env.OPENAI_MODEL || "gpt-5-mini";

  if (!key) {
    return res.status(500).json({
      error: "OPENAI_API_KEY is missing in Vercel settings."
    });
  }

  const messages = req.body?.messages;

  if (!Array.isArray(messages)) {
    return res.status(400).json({ error: "Invalid messages." });
  }

  const safeMessages = messages
    .filter(m =>
      m &&
      ["user", "assistant"].includes(m.role) &&
      typeof m.content === "string"
    )
    .slice(-12)
    .map(m => ({
      role: m.role,
      content: m.content.slice(0, 4000)
    }));

  if (!safeMessages.length) {
    return res.status(400).json({ error: "Ask a question first." });
  }

  try {
    const result = await fetch(
      "https://api.openai.com/v1/chat/completions",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${key}`
        },
        body: JSON.stringify({
          model,
          messages: [
            {
              role: "system",
              content: "You are StudySpace AI Teacher. Help school students learn with clear, age-appropriate explanations, worked examples and revision questions. Explain steps and encourage understanding."
            },
            ...safeMessages
          ]
        })
      }
    );

    const data = await result.json();

    if (!result.ok) {
      console.error("OpenAI API error:", data.error?.message);
      return res.status(502).json({
        error: "The AI provider returned an error. Check your model access and API billing."
      });
    }

    const answer = data.choices?.[0]?.message?.content;

    if (!answer) {
      return res.status(502).json({ error: "No answer was returned." });
    }

    return res.status(200).json({ answer });
  } catch (error) {
    console.error("AI backend error:", error);
    return res.status(500).json({ error: "Could not reach the AI service." });
  }
}
